{
  "type": "minilamp.grouser", "version": 1, "title": "Grousers",
  "description": "MiniLAMP's opposing front/rear wheel rotation, on/off. Release to stop.",
  "endpoints": {"command": {"topic": "i/grouser", "kind": "command", "qos": 0, "retain": false,
    "schema": {"type": "object", "properties": {"value": {"type": "number", "minimum": -1, "maximum": 1}},
      "required": ["value"], "additionalProperties": false}}},
  "actions": {"rotate": {"label": "Grouser direction", "min": -1, "max": 1, "neutral": 0, "step": 1, "reset_on_release": true}},
  "commands": [{"endpoint": "command", "fields": {"value": "rotate"}, "repeat_ms": 250}],
  "bindings": [
    {"id": "grouser-back", "input": "keyboard", "code": "KeyQ", "action": "rotate", "value": -1},
    {"id": "grouser-forward", "input": "keyboard", "code": "KeyE", "action": "rotate", "value": 1},
    {"id": "stop", "input": "keyboard", "code": "Space", "reset": true}
  ],
  "ui": {"columns": 1, "controls": [
    {"kind": "range", "label": "Grouser direction (Q/E)", "action": "rotate"},
    {"kind": "reset", "label": "Stop grousers"}
  ]}
}
