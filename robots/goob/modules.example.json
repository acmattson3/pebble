{
  "robot": {
    "system": "pebble",
    "type": "robots",
    "id": "goob"
  },
  "services": {
    "module_host": {
      "enabled": true,
      "modules": [
        {
          "id": "drive",
          "use": "modules/drive/module.json",
          "adapters": {
            "command": {
              "kind": "forward",
              "subtopic": "incoming/drive-values"
            }
          }
        },
        {
          "id": "soundboard",
          "use": "modules/soundboard/module.json",
          "adapters": {
            "command": {
              "kind": "forward",
              "subtopic": "incoming/soundboard-command"
            }
          }
        },
        {
          "id": "lights",
          "use": "modules/lights/module.json",
          "adapters": {
            "solid": {
              "kind": "forward",
              "subtopic": "incoming/lights-solid"
            },
            "flash": {
              "kind": "forward",
              "subtopic": "incoming/lights-flash"
            }
          }
        },
        {
          "id": "telemetry",
          "use": "modules/telemetry/module.json",
          "endpoints": ["battery", "imu", "imu_calibrate"],
          "adapters": {
            "imu_calibrate": {
              "kind": "forward",
              "subtopic": "incoming/imu/calibrate"
            }
          },
          "ui": {
            "columns": 1,
            "controls": [{
              "kind": "telemetry",
              "label": "Robot telemetry",
              "presence": true,
              "metrics": [
                {"label": "Battery", "endpoint": "battery", "field": "value", "unit": "V", "precision": 2}
              ]
            }, {
              "kind": "orientation-3d",
              "label": "Robot orientation",
              "endpoint": "imu",
              "command_endpoint": "imu_calibrate",
              "model_url": "https://sssn.us/files/blockoutModel.glb",
              "model_rotation_deg": {"x": -90, "y": -4.5, "z": 0}
            }]
          }
        },
        {
          "id": "logs",
          "use": "modules/logs/module.json"
        },
        {
          "id": "autonomy",
          "use": "modules/autonomy/module.json"
        },
        {
          "id": "admin",
          "use": "modules/admin/module.json",
          "endpoints": ["reboot", "git_pull", "service_restart"],
          "ui": {
            "columns": 1,
            "controls": [{
              "kind": "admin",
              "label": "Robot administration",
              "actions": [
                {"id": "reboot", "label": "Reboot robot", "endpoint": "reboot", "confirmation": "Reboot Goob now? The robot will disconnect until it starts again."},
                {"id": "git_pull", "label": "Update from Git", "endpoint": "git_pull", "confirmation": "Run Goob's configured Git update command now?"},
                {"id": "service_restart", "label": "Restart services", "endpoint": "service_restart", "confirmation": "Restart Goob's configured services now?"}
              ]
            }]
          },
          "adapters": {
            "reboot": {"kind": "forward", "subtopic": "incoming/flags/reboot"},
            "git_pull": {"kind": "forward", "subtopic": "incoming/flags/git-pull"},
            "service_restart": {"kind": "forward", "subtopic": "incoming/flags/service-restart"}
          }
        }
      ]
    }
  }
}
