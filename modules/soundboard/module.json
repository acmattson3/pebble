{
  "type": "pebble.soundboard",
  "version": 1,
  "title": "Soundboard",
  "description": "Play sounds, adjust this robot's speaker volume, or stop playback.",
  "endpoints": {
    "command": {
      "topic": "i/soundboard/command",
      "kind": "command",
      "schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["play", "stop", "volume"]
          },
          "file": {
            "type": "string",
            "maxLength": 512
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["action"],
        "oneOf": [
          {"properties": {"action": {"const": "play"}}, "required": ["action", "file"], "maxProperties": 2},
          {"properties": {"action": {"const": "stop"}}, "required": ["action"], "maxProperties": 1},
          {"properties": {"action": {"const": "volume"}}, "required": ["action", "volume"], "maxProperties": 2}
        ],
        "additionalProperties": false
      },
      "qos": 0,
      "retain": false
    },
    "files": {
      "topic": "o/soundboard/files",
      "kind": "state",
      "schema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "maxItems": 2048
          },
          "controls": {"type": "boolean"},
          "timestamp": {"type": "number"}
        },
        "required": ["files", "controls", "timestamp"],
        "additionalProperties": false
      },
      "qos": 1,
      "retain": true
    },
    "status": {
      "topic": "o/soundboard/status",
      "kind": "state",
      "schema": {
        "type": "object",
        "properties": {
          "playing": {"type": "boolean"},
          "file": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]},
          "controls": {"type": "boolean"},
          "volume": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "timestamp": {"type": "number"}
        },
        "required": ["playing", "file", "error", "controls", "timestamp"],
        "additionalProperties": false
      },
      "qos": 1,
      "retain": true
    }
  },
  "actions": {},
  "commands": [],
  "bindings": [
    {
      "id": "play-selected-sound",
      "input": "keyboard",
      "code": "KeyP",
      "widget": "soundboard",
      "widget_action": "play-selected"
    }
  ],
  "ui": {
    "columns": 1,
    "controls": [
      {
        "kind": "soundboard",
        "id": "soundboard",
        "label": "Soundboard",
        "command_endpoint": "command",
        "files_endpoint": "files",
        "status_endpoint": "status",
        "volume": {"enabled": true, "min": 0, "max": 100, "step": 1},
        "key_actions": [
          {"id": "play-selected", "label": "Play selected sound", "behavior": "play-selected"}
        ]
      }
    ]
  }
}
