{
  "type": "pebble.drive",
  "version": 1,
  "title": "Drive",
  "description": "Shared forward and turn controls. Keyboard, controller, and touch use the same actions.",
  "endpoints": {
    "command": {
      "topic": "i/drive",
      "kind": "command",
      "schema": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "z": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "z"
        ],
        "additionalProperties": false
      },
      "qos": 0,
      "retain": false
    }
  },
  "actions": {
    "forward": {
      "label": "Forward",
      "min": -1,
      "max": 1,
      "neutral": 0,
      "step": 0.05,
      "reset_on_release": true
    },
    "turn": {
      "label": "Turn",
      "min": -1,
      "max": 1,
      "neutral": 0,
      "step": 0.05,
      "reset_on_release": true
    }
  },
  "commands": [
    {
      "endpoint": "command",
      "fields": {
        "x": "turn",
        "z": "forward"
      },
      "repeat_ms": 250
    }
  ],
  "bindings": [
    {
      "id": "w",
      "input": "keyboard",
      "code": "KeyW",
      "action": "forward",
      "value": 1
    },
    {
      "id": "s",
      "input": "keyboard",
      "code": "KeyS",
      "action": "forward",
      "value": -1
    },
    {
      "id": "a",
      "input": "keyboard",
      "code": "KeyA",
      "action": "turn",
      "value": -1
    },
    {
      "id": "d",
      "input": "keyboard",
      "code": "KeyD",
      "action": "turn",
      "value": 1
    },
    {
      "id": "stop",
      "input": "keyboard",
      "code": "Space",
      "reset": true
    },
    {
      "id": "stick-forward",
      "input": "gamepad-axis",
      "index": 1,
      "action": "forward",
      "scale": -1,
      "deadzone": 0.12
    },
    {
      "id": "stick-turn",
      "input": "gamepad-axis",
      "index": 0,
      "action": "turn",
      "deadzone": 0.12
    }
  ],
  "ui": {
    "columns": 2,
    "controls": [
      {
        "kind": "joystick",
        "label": "Drive stick",
        "x": "turn",
        "y": "forward",
        "invert_y": true
      },
      {
        "kind": "range",
        "label": "Forward",
        "action": "forward"
      },
      {
        "kind": "range",
        "label": "Turn",
        "action": "turn"
      },
      {
        "kind": "reset",
        "label": "Stop"
      }
    ]
  }
}
