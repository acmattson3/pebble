{
  "type": "pebble.telemetry",
  "version": 1,
  "title": "Telemetry",
  "description": "A reusable dashboard for robot state and sensor readings.",
  "endpoints": {
    "charging": {
      "topic": "o/telemetry/charging",
      "kind": "state",
      "schema": {
        "type": "object",
        "properties": {
          "value": {"type": ["boolean", "null"]}
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "qos": 1,
      "retain": true
    },
    "battery": {
      "topic": "o/telemetry/battery",
      "kind": "state",
      "schema": {
        "type": "object",
        "properties": {
          "value": {"type": "number", "minimum": 0, "maximum": 100},
          "unit": {"const": "v"}
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "qos": 1,
      "retain": true
    },
    "touch": {
      "topic": "o/telemetry/touch",
      "kind": "state",
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "properties": {
              "a0": {"type": "integer", "minimum": 0, "maximum": 65535},
              "a1": {"type": "integer", "minimum": 0, "maximum": 65535},
              "a2": {"type": "integer", "minimum": 0, "maximum": 65535}
            },
            "required": ["a0", "a1", "a2"],
            "additionalProperties": false
          },
          "unit": {"const": "adc"}
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "qos": 0,
      "retain": false
    },
    "imu": {
      "topic": "o/telemetry/imu",
      "kind": "state",
      "schema": {
        "type": "object",
        "properties": {
          "orientation_deg": {
            "type": "object",
            "properties": {
              "roll": {"type": "number"},
              "pitch": {"type": "number"},
              "yaw": {"type": "number"}
            },
            "required": ["roll", "pitch"],
            "additionalProperties": false
          },
          "accel_norm_g": {"type": "number", "minimum": 0},
          "accel_mps2": {
            "type": "object",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "z": {"type": "number"}
            },
            "required": ["x", "y", "z"],
            "additionalProperties": false
          },
          "temperature_c": {"type": "number"},
          "health": {
            "type": "object",
            "properties": {
              "device": {"type": "string"},
              "protocol": {"type": "string"},
              "samples_ok": {"type": "integer", "minimum": 0},
              "samples_error": {"type": "integer", "minimum": 0},
              "calibration_samples": {"type": "integer", "minimum": 0},
              "calibration_generation": {"type": "integer", "minimum": 0},
              "gyro_bias_dps": {
                "type": "object",
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "z": {"type": "number"}
                },
                "required": ["x", "y", "z"],
                "additionalProperties": false
              }
            },
            "required": ["device", "protocol", "samples_ok", "samples_error", "calibration_samples", "calibration_generation", "gyro_bias_dps"],
            "additionalProperties": false
          }
        },
        "required": ["orientation_deg", "accel_norm_g", "temperature_c", "health"],
        "additionalProperties": false
      },
      "qos": 1,
      "retain": true
    },
    "imu_calibrate": {
      "topic": "i/imu/calibrate",
      "kind": "command",
      "schema": {
        "type": "object",
        "properties": {
          "action": {"const": "calibrate"}
        },
        "required": ["action"],
        "additionalProperties": false
      },
      "qos": 1,
      "retain": false
    }
  },
  "actions": {},
  "commands": [],
  "bindings": [],
  "ui": {
    "columns": 1,
    "controls": [
      {
        "kind": "telemetry",
        "label": "Robot telemetry",
        "metrics": [
          {"label": "Charging", "endpoint": "charging", "field": "value"},
          {"label": "Battery", "endpoint": "battery", "field": "value", "unit": "V", "precision": 2},
          {"label": "Touch sensors", "endpoint": "touch", "field": "value", "unit": "ADC"},
          {"label": "IMU orientation", "endpoint": "imu", "field": "orientation_deg", "unit": "deg", "precision": 1},
          {"label": "IMU acceleration magnitude", "endpoint": "imu", "field": "accel_norm_g", "unit": "g", "precision": 3},
          {"label": "IMU temperature", "endpoint": "imu", "field": "temperature_c", "unit": "°C", "precision": 1}
        ]
      }
    ]
  }
}
